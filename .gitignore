# Built by scripts/release.sh, never edited by hand.
dist/

# Scratch checkouts. They are real git worktrees of this same repo, so
# committing one embeds a repository inside itself and a clone gets a directory
# it cannot fill. Tooling-specific scratch paths live in .git/info/exclude,
# which stays on the machine that made them.
.worktrees/

# The CurseForge upload token, read by scripts/deploy.sh. It is a credential
# that can publish a file under this project's name, this repository is public,
# and a token in a commit is a token that has to be revoked. It belongs on the
# machine that uploads and nowhere else.
.curseforge-token

# Merge and patch leftovers. They are byte-identical copies of tracked files
# and get committed by a wide `git add` before anyone notices.
*.orig
*.rej

# The level up fanfare, and the only asset the addon names but does not ship.
# src/Media/BestAround.mp3 is five seconds of a record somebody else made, taken
# out of the addon of the same name; it is not ours to relicense and this
# repository is public. It stays on the disk of anybody who puts it there, the
# part goes quiet without it, and neither the repo nor the release zip carries
# it. Its licence file is ignored with it because check.sh fails a licence that
# describes a file that is not there.
src/Media/BestAround.mp3
src/Media/BestAround-LICENSE.txt
